# Copy to .env (git ignores it) for local builds: python3 build_pwa.py
# Supabase > Project Settings > API: the project URL and the PUBLISHABLE key (sb_publishable_...).
# Never put the secret key (sb_secret_... or service_role) here or anywhere in this repo.
DOWNTIME_SUPABASE_URL=https://your-project.supabase.co
DOWNTIME_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
